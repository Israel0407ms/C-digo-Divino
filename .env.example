# Copie os valores para as variáveis de ambiente do seu sistema
# (ou para um .env que você carregue — nunca commite o .env real).

# Obrigatória para narração dos vídeos — https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=

# Opcional: ID de uma voz PT-BR da Voice Library da ElevenLabs.
# Sem isso, usa a voz padrão multilíngue (funciona, mas com leve sotaque).
ELEVENLABS_VOICE_ID=
